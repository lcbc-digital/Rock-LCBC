/-
    Path: {% include '~~/Assets/Lava/Custom/ModularSystem/Modules/TimedShowcase.lava', module:module, content:content, settings:settings %}
    Description: Adapter for the Module V2 - Timed Showcase channel. Turns the Items attribute matrix into the
                 array of rows the template expects, then renders the template.

    Parameters:
        module   - The content channel item. (Required, ContentChannelItem)
        content  - The content dictionary from Modules/Base.lava. (Required, Dictionary)
        settings - The settings dictionary from Modules/Base.lava. (Required, Dictionary)
-/

//- MARK: Items
{% assign itemRows = module | Attribute:'Items','Object' | Property:'AttributeMatrixItems' | OrderBy:'Order' %}

{% assign itemList = '' %}
{% for row in itemRows %}
    {% assign rowImage = row | Attribute:'Image','Url' %}
    {% capture rowImage %}{% include '~~/Assets/Lava/Custom/Common/CdnUrl.lava', cdnUrl:rowImage, cdnParams:'' %}{% endcapture %}
    {% assign rowImage = rowImage | Trim %}

    {% if rowImage != blank %}
        {% assign rowTitle = row | Attribute:'Title' %}
        {% assign rowDescription = row | Attribute:'Description' %}
        {% assign rowLinkText = row | Attribute:'LinkText' %}
        {% assign rowLinkUrl = row | Attribute:'LinkUrl' %}

        {% assign item = ''
            | AddToDictionary:'image',rowImage
            | AddToDictionary:'title',rowTitle
            | AddToDictionary:'description',rowDescription
            | AddToDictionary:'linktext',rowLinkText
            | AddToDictionary:'linkurl',rowLinkUrl
        %}

        {% assign itemList = itemList | AddToArray:item %}
    {% endif %}
{% endfor %}

{% assign content = content | AddToDictionary:'items',itemList %}

//- MARK: Colors
{% assign cardBackgroundColor = module | Attribute:'CardBackgroundColor' %}
{% assign timerColor = module | Attribute:'TimerColor' %}

{% assign colors = settings.colors
    | AddToDictionary:'card',cardBackgroundColor
    | AddToDictionary:'timer',timerColor
%}
{% assign settings = settings | AddToDictionary:'colors',colors %}

//- MARK: Duration
{% assign durationSeconds = module | Attribute:'Duration' %}
{% if durationSeconds != blank and durationSeconds != '0' %}
    {% assign durationMilliseconds = durationSeconds | Times:1000 %}
    {% assign settings = settings | AddToDictionary:'duration',durationMilliseconds %}
{% endif %}

//- MARK: Markup
{% include '~~/Assets/Lava/Custom/Templates/TimedShowcase.lava', content:content, settings:settings %}
