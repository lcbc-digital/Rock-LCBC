/-
    Path: {% include '~~/Assets/Lava/Custom/ModularSystem/Modules/TextHighlight.lava', module:module, content:content, settings:settings %}
    Description: Adapter for the Module V2 - Text Highlight channel. Adds the quote, its buttons and the
                 highlight color to the dictionaries built by Modules/Base.lava, then renders the template.

    Parameters:
        module   - The content channel item. (Required, ContentChannelItem)
        content  - The content dictionary from Modules/Base.lava. (Required, Dictionary)
        settings - The settings dictionary from Modules/Base.lava. (Required, Dictionary)
-/

//- MARK: Content
{% assign text = module | Attribute:'Text' %}

//- See ButtonGroup.lava for why the JSON round trip is required on a key value list.
{% assign buttons = module | Attribute:'Buttons','Object' | ToJSON | FromJSON %}

{% assign content = content
    | AddToDictionary:'text',text
    | AddToDictionary:'buttons',buttons
%}

//- MARK: Colors
{% assign highlightedTextColor = module | Attribute:'HighlightedTextColor' %}

{% assign colors = settings.colors
    | AddToDictionary:'highlightedtext',highlightedTextColor
%}

{% assign settings = settings | AddToDictionary:'colors',colors %}

//- MARK: Markup
{% include '~~/Assets/Lava/Custom/Templates/TextHighlight.lava', content:content, settings:settings %}
