/-
    Path: {% include '~~/Assets/Lava/Custom/ModularSystem/Modules/Cards.lava', module:module, content:content, settings:settings %}
    Description: Adapter for the Module V2 - Cards channel. Turns the Cards attribute matrix into the array of
                 card dictionaries the template expects, adds the display settings, then renders the template.

    Parameters:
        module   - The content channel item. (Required, ContentChannelItem)
        content  - The content dictionary from Modules/Base.lava. (Required, Dictionary)
        settings - The settings dictionary from Modules/Base.lava. (Required, Dictionary)
-/

//- MARK: Cards
{% assign cardRows = module | Attribute:'Cards','Object' | Property:'AttributeMatrixItems' | OrderBy:'Order' %}

{% assign cardList = '' %}
{% for row in cardRows %}
    {% assign rowHeading = row | Attribute:'Heading' %}
    {% assign rowDescription = row | Attribute:'Description' %}
    {% assign rowAccentColor = row | Attribute:'AccentColor' %}

    //- See ButtonGroup.lava for why the JSON round trip is required on a key value list.
    {% assign rowButtons = row | Attribute:'Buttons','Object' | ToJSON | FromJSON %}

    {% assign rowImageGuid = row | Attribute:'Image','RawValue' %}
    {% assign rowImageUrl = '' %}
    {% if rowImageGuid != blank %}
        {% assign rowImageUrl = rowImageGuid | ImageUrl %}
        {% capture rowImageUrl %}{% include '~~/Assets/Lava/Custom/Common/CdnUrl.lava', cdnUrl:rowImageUrl, cdnParams:'' %}{% endcapture %}
        {% assign rowImageUrl = rowImageUrl | Trim %}
    {% endif %}

    {% assign card = ''
        | AddToDictionary:'heading',rowHeading
        | AddToDictionary:'description',rowDescription
        | AddToDictionary:'image',rowImageUrl
        | AddToDictionary:'accentcolor',rowAccentColor
        | AddToDictionary:'buttons',rowButtons
    %}

    {% assign cardList = cardList | AddToArray:card %}
{% endfor %}

{% assign content = content | AddToDictionary:'cards',cardList %}

//- MARK: Display Settings
{% assign cardType = module | Attribute:'CardType','RawValue' %}
{% assign cardWidth = module | Attribute:'CardWidth','RawValue' %}

{% assign cardsDisplay = ''
    | AddToDictionary:'cardtype',cardType
    | AddToDictionary:'cardwidth',cardWidth
%}

{% assign settings = settings | AddToDictionary:'cards',cardsDisplay %}

//- MARK: Markup
{% include '~~/Assets/Lava/Custom/Templates/Cards.lava', content:content, settings:settings %}
