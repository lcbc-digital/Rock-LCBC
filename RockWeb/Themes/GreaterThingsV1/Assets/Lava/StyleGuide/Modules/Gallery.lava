/-
    Add an example by capturing the markup and handing it to the Example
    partial -- it renders the demo and the escaped source for you.

    {% capture demo %}
    <div class="example">...</div>
    {% endcapture %}
    {% include '~/Themes/GreaterThingsV1/Assets/Lava/StyleGuide/Partials/Example.lava', id:'default', title:'Default', demo:demo %}
-/
