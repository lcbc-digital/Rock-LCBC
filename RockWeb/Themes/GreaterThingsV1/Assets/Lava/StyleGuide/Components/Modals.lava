{% include '~/Themes/GreaterThingsV1/Assets/Lava/StyleGuide/Partials/PageHeader.lava', title:'Modals', description:'Bootstrap modal dialogs — standard, sized, and scrollable. Trigger with <code>data-toggle="modal"</code> on any element.' %}


//- MARK: Markup
{% capture standard %}
<button type="button" class="btn btn-primary" data-toggle="modal" data-target="#dlg-standard">
    Launch Modal
</button>

<div class="modal fade" id="dlg-standard" tabindex="-1" role="dialog" aria-labelledby="dlg-standard-label">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
                <h4 class="modal-title" id="dlg-standard-label">Modal Title</h4>
            </div>
            <div class="modal-body">
                <p>Modal body content goes here. Use this for forms, confirmations, or supplemental information that doesn't need a full page.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary">Save Changes</button>
            </div>
        </div>
    </div>
</div>
{% endcapture %}
{% include '~/Themes/GreaterThingsV1/Assets/Lava/StyleGuide/Partials/Example.lava', id:'modal-standard', title:'Standard', demo:standard %}

{% capture nofooter %}
<button type="button" class="btn btn-primary" data-toggle="modal" data-target="#dlg-nofooter">
    Launch Modal
</button>

<div class="modal fade" id="dlg-nofooter" tabindex="-1" role="dialog" aria-labelledby="dlg-nofooter-label">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
                <h4 class="modal-title" id="dlg-nofooter-label">No Footer</h4>
            </div>
            <div class="modal-body">
                <p>Omit <code>.modal-footer</code> for read-only content or when a dismiss button in the header is sufficient.</p>
            </div>
        </div>
    </div>
</div>
{% endcapture %}
{% include '~/Themes/GreaterThingsV1/Assets/Lava/StyleGuide/Partials/Example.lava', id:'modal-nofooter', title:'No Footer', demo:nofooter %}

{% capture large %}
<button type="button" class="btn btn-primary" data-toggle="modal" data-target="#dlg-large">
    Launch Large Modal
</button>

<div class="modal fade" id="dlg-large" tabindex="-1" role="dialog" aria-labelledby="dlg-large-label">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
                <h4 class="modal-title" id="dlg-large-label">Large Modal</h4>
            </div>
            <div class="modal-body">
                <p>Add <code>.modal-lg</code> to <code>.modal-dialog</code> for a wider dialog. Useful for tables, media, or multi-column layouts.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
{% endcapture %}
{% include '~/Themes/GreaterThingsV1/Assets/Lava/StyleGuide/Partials/Example.lava', id:'modal-large', title:'Large', demo:large %}

{% capture small %}
<button type="button" class="btn btn-primary" data-toggle="modal" data-target="#dlg-small">
    Launch Small Modal
</button>

<div class="modal fade" id="dlg-small" tabindex="-1" role="dialog" aria-labelledby="dlg-small-label">
    <div class="modal-dialog modal-sm" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
                <h4 class="modal-title" id="dlg-small-label">Confirm</h4>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete this item? This action cannot be undone.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger">Delete</button>
            </div>
        </div>
    </div>
</div>
{% endcapture %}
{% include '~/Themes/GreaterThingsV1/Assets/Lava/StyleGuide/Partials/Example.lava', id:'modal-small', title:'Small', demo:small %}

{% capture scrolling %}
<button type="button" class="btn btn-primary" data-toggle="modal" data-target="#dlg-scroll">
    Launch Scrolling Modal
</button>

<div class="modal fade" id="dlg-scroll" tabindex="-1" role="dialog" aria-labelledby="dlg-scroll-label">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
                <h4 class="modal-title" id="dlg-scroll-label">Long Content</h4>
            </div>
            <div class="modal-body">
                <p>This is a modal with a lot of content that will cause the body to scroll.</p>
                {% for i in (1..8) %}
                <p>Paragraph {{ i }} — Curabitur blandit tempus porttitor. Aenean lacinia bibendum nulla sed consectetur. Vivamus sagittis lacus vel augue laoreet rutrum faucibus dolor auctor.</p>
                {% endfor %}
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary">Confirm</button>
            </div>
        </div>
    </div>
</div>
{% endcapture %}
{% include '~/Themes/GreaterThingsV1/Assets/Lava/StyleGuide/Partials/Example.lava', id:'modal-scroll', title:'Scrolling Content', demo:scrolling %}
